 Thread privateVideoThreadHandle = NULL;
 static void videoThread(void* data);
 
+// Stereoscopic 3D: right-eye render target and texture
+C3D_RenderTarget *VideoSurfaceR;
+static C3D_Tex right_tex;
+static bool right_tex_ready = false;
+static bool scene_scale = false;      // render targets are 2x supersampled
+static SDL_VideoDevice *n3ds_device = NULL;
+
+static void stopVideoThread(void)
+{
+	if (privateVideoThreadHandle) {
+		runThread = false;
+		LightEvent_Signal(&privateVideoThreadEvent);
+		threadJoin(privateVideoThreadHandle, U64_MAX);
+		threadFree(privateVideoThreadHandle);
+		privateVideoThreadHandle = NULL;
+	}
+}
+
+static void startVideoThread(_THIS)
+{
+	runThread = true;
+	LightEvent_Init(&privateVideoThreadEvent, RESET_ONESHOT);
+	// libctru sys threads uses 0x18, so we use a lower priority, but higher than any other SDL thread.
+	// Joinable (not detached): joining a detached thread reads its freed Thread struct.
+	privateVideoThreadHandle = threadCreate(videoThread, (void *) this, STACKSIZE, 0x19, -2, false);
+}
+
+static void createRightTarget(GSPGPU_FramebufferFormat mode)
+{
+	// No depth buffer: the scene is a single textured quad.
+	if (scene_scale)
+		VideoSurfaceR = C3D_RenderTargetCreate(240*2, 400*2, mode, -1);
+	else
+		VideoSurfaceR = C3D_RenderTargetCreate(240, 400, mode, -1);
+	if (VideoSurfaceR)
+		C3D_RenderTargetSetOutput(VideoSurfaceR, GFX_TOP, GFX_RIGHT, displayTranferFlags[mode] |
+			GX_TRANSFER_SCALING(scene_scale ? GX_TRANSFER_SCALE_XY : GX_TRANSFER_SCALE_NO));
+}
+
+static void freeRightEye(_THIS)
+{
+	if (VideoSurfaceR) {
+		C3D_RenderTargetDelete(VideoSurfaceR);
+		VideoSurfaceR = NULL;
+	}
+	if (right_tex_ready) {
+		C3D_TexDelete(&right_tex);
+		right_tex_ready = false;
+	}
+	if (this->hidden->buffer_r) {
+		linearFree(this->hidden->buffer_r);
+		this->hidden->buffer_r = NULL;
+	}
+	this->hidden->right_pixels = NULL;
+	this->hidden->right_valid = false;
+}
+
+// Allocates the right-eye buffer, texture and render target for the current mode.
+static int allocRightEye(_THIS)
+{
+	size_t size = this->hidden->w * this->hidden->h * this->hidden->byteperpixel;
+
+	this->hidden->buffer_r = linearAlloc(size);
+	if (!this->hidden->buffer_r) {
+		SDL_SetError("right-eye buffer: %u bytes, %u linear free", (unsigned)size, (unsigned)linearSpaceFree());
+		return -1;
+	}
+	SDL_memset(this->hidden->buffer_r, 0, size);
+
+	if (!C3D_TexInit(&right_tex, this->hidden->w, this->hidden->h, this->hidden->mode)) {
+		SDL_SetError("right-eye texture %dx%d fmt %d: %u linear free", this->hidden->w, this->hidden->h,
+			(int)this->hidden->mode, (unsigned)linearSpaceFree());
+		freeRightEye(this);
+		return -1;
+	}
+	right_tex_ready = true;
+	C3D_TexSetFilter(&right_tex, this->hidden->fitscreen ? GPU_LINEAR : GPU_NEAREST, GPU_NEAREST);
+
+	createRightTarget(this->hidden->mode);
+	if (!VideoSurfaceR) {
+		SDL_SetError("right-eye target (scale %d, fmt %d): %u VRAM free", (int)scene_scale,
+			(int)this->hidden->mode, (unsigned)vramSpaceFree());
+		freeRightEye(this);
+		return -1;
+	}
+	return 0;
+}
+
+/* Turn the top screen's stereoscopic mode on or off. Call after SDL_SetVideoMode().
+   While on, each flip shows the frame passed to SDL_N3DS_SetRightEyeFrame() to the
+   right eye, or the normal (left) frame to both eyes when none was passed. */
+int SDL_N3DS_SetStereo(int enable)
+{
+	_THIS = n3ds_device;
+	enable = enable ? 1 : 0;
+
+	if (!this || !this->hidden->buffer)
+		return -1;
+	if (enable == this->hidden->stereo)
+		return 0;
+
+	int ret = 0;
+
+	stopVideoThread();
+	if (enable) {
+		if (allocRightEye(this) == 0) {
+			gfxSet3D(true);
+			this->hidden->stereo = true;
+		} else {
+			ret = -1; // allocRightEye set the error
+		}
+	} else {
+		freeRightEye(this);
+		gfxSet3D(false);
+		this->hidden->stereo = false;
+	}
+	startVideoThread(this);
+
+	return ret;
+}
+
+/* Supply the right-eye image for the next SDL_Flip()/SDL_UpdateRect() only. The buffer
+   must match the video surface's size and format (8bpp uses the surface palette). */
+void SDL_N3DS_SetRightEyeFrame(const Uint8 *pixels, int pitch)
+{
+	if (!n3ds_device)
+		return;
+	n3ds_device->hidden->right_pixels = pixels;
+	n3ds_device->hidden->right_pitch = pitch;
+}
