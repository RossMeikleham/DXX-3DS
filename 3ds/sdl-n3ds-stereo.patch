+// Copy the app's right-eye frame into the RGBA staging buffer (palette lookup for 8bpp).
+static void convertRightEye(_THIS)
+{
+	const Uint8 *src = this->hidden->right_pixels;
+	int pitch = this->hidden->right_pitch;
+	int x, y;
+
+	if (this->hidden->bpp == 8) {
+		Uint32 *palette = this->hidden->palette;
+		for (y = 0; y < this->info.current_h; y++) {
+			const Uint8 *s = src + y * pitch;
+			Uint32 *d = (Uint32 *)this->hidden->buffer_r + y * this->hidden->w;
+			for (x = 0; x < this->info.current_w; x++)
+				*d++ = palette[*s++];
+		}
+	} else {
+		int rowbytes = this->info.current_w * this->hidden->byteperpixel;
+		for (y = 0; y < this->info.current_h; y++)
+			SDL_memcpy((Uint8 *)this->hidden->buffer_r + y * this->hidden->w * this->hidden->byteperpixel,
+				src + y * pitch, rowbytes);
+	}
+}
